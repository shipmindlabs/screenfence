  "author": "Shipmind Labs <hello@shipmindlabs.com>",
  "homepage": "https://shipmindlabs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shipmindlabs/screenfence.git"
  },
  "bugs": {
    "url": "https://github.com/shipmindlabs/screenfence/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  }
}
